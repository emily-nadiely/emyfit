{
  "id": "./",
  "name": "Progressa",
  "short_name": "Progressa",
  "description": "Treino adaptativo, cardio, recuperação muscular e relatórios.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#070709",
  "theme_color": "#070709",
  "lang": "pt-BR",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "categories": [
    "fitness",
    "health",
    "lifestyle"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./progressa-icon-v640-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./progressa-icon-v640-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./progressa-icon-v640-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
